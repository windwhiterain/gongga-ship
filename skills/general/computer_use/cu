#!/usr/bin/env bash
# Entry point for the desktop driver.
#
# The implementation is Python only. The other skills in this repo (image, compact)
# already require Python, so a second implementation in PowerShell would be a copy
# of the same logic with no new reach -- and two copies of one fact drift, which is
# how the UIA tree walker here broke once already.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# uv resolves the inline dependencies (comtypes on Windows, pyobjc on macOS) without
# asking anyone to install them first.
if command -v uv >/dev/null 2>&1; then
  exec uv run --quiet "$here/cu.py" "$@"
fi

for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 \
     && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    exec "$candidate" "$here/cu.py" "$@"
  fi
done

echo "no Python 3.9+ found (tried uv, python3, python, py); install uv from https://docs.astral.sh/uv/" >&2
exit 1
