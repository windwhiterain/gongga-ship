#!/usr/bin/env bash
# One entry for the two things this skill does, so `gongga-cli skill subagent ...`
# reaches both: `spawn` starts a subagent under a name nobody else can hold,
# `wait_turn` waits for one's turn to end.
#
#   gongga-cli skill subagent spawn impl --cwd .
#   gongga-cli skill subagent wait_turn main/impl
#
# Anything else is a mistake worth naming rather than a script run with the wrong
# arguments: a verb this skill does not have is echoed with the two it does.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
verb="${1:-}"
case "$verb" in
  spawn)     shift; exec "$here/spawn" "$@" ;;
  wait_turn) shift; exec "$here/wait_turn" "$@" ;;
  "" | -h | --help | help)
    echo "usage: run spawn <role> [--cwd PATH] [--model M] [--context-limit N%] [--parent P]" >&2
    echo "       run wait_turn <session> [--timeout S] [--interval S] [--quiet]" >&2
    [ -n "$verb" ] && exit 0
    exit 2 ;;
  *)
    echo "run: no verb '$verb'; this skill has spawn and wait_turn" >&2
    exit 2 ;;
esac
