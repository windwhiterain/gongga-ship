#!/usr/bin/env bash
# Entry point that finds a Python worth running this under.
#
# `python3` is not always one: on Windows, Git Bash resolves it to the Store stub,
# which prints an install advert and exits 49.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 \
     && "$candidate" -c 'import json' >/dev/null 2>&1; then
    exec "$candidate" "$here/wait_turn.py" "$@"
  fi
done
echo "wait_turn requires Python 3 (tried python3, python, py)" >&2
exit 1
