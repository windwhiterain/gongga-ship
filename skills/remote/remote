#!/usr/bin/env bash
# Python 3.11 supplies tomllib; the probe avoids Windows' inert Store alias.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 \
     && "$candidate" -c 'import sys, tomllib; assert sys.version_info >= (3, 11)' >/dev/null 2>&1; then
    exec "$candidate" "$here/remote.py" "$@"
  fi
done
echo "remote requires Python 3.11 or newer (tried python3, python, py)" >&2
exit 1
