#!/usr/bin/env bash
# Entry point that finds a Python which can actually open a database.
#
# `python3` is not always one: on Windows, Git Bash resolves it to the Store stub,
# which prints an install advert and exits 49. Probing is cheaper than making the
# agent work out which name this machine honours.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

for candidate in python3 python py; do
  if command -v "$candidate" >/dev/null 2>&1 \
     && "$candidate" -c 'import sqlite3' >/dev/null 2>&1; then
    exec "$candidate" "$here/transcript.py" "$@"
  fi
done

echo "no Python with sqlite3 found (tried python3, python, py)" >&2
exit 1
